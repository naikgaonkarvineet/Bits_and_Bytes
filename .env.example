# ==========================================
# KaamSetu Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your Supabase credentials:
# cp .env.example .env

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (for client-side or authenticated public API requests)
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (for secure server-side operations bypassing RLS)
# Keep this strictly confidential and NEVER commit to GitHub!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Node.js Server Port (optional, defaults to 5000)
PORT=5000
